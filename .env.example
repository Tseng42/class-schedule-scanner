# Copy this file to .env and fill in your own key. Never commit .env.
# Get a key at https://console.anthropic.com (requires a prepaid credit balance).
VITE_ANTHROPIC_API_KEY=

# Cloud sync (optional) — from a Firebase project's Web App config (console.firebase.google.com).
# Unlike the Anthropic key above, these are NOT secret: Firebase's client config is meant to be
# public in the bundle. Access control comes from Firestore Security Rules, not from hiding this.
# Safe to set directly as normal Vercel project environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# LINE reminders (optional) — these are REAL secrets, read only by the server functions in /api.
# Set them in Vercel as type "Secret". Never give them a VITE_ prefix (that would publish them
# in the browser bundle) and there is no need to put them in this local .env at all.
#
#   CRON_SECRET                 random string; the scheduler (cron-job.org) sends it as "Authorization: Bearer <value>"
#   LINE_CHANNEL_ACCESS_TOKEN   LINE Developers console → Messaging API → Channel access token
#   LINE_USER_ID                LINE Developers console → Basic settings → Your user ID (starts with U)
#   LINE_OWNER_EMAIL            the Google account you sign in to cloud sync with
#   FIREBASE_SERVICE_ACCOUNT    Firebase console → Project settings → Service accounts → new private key (whole JSON)
