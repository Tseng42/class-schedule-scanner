# Copy this file to .env and fill in your own key. Never commit .env.
# Get a key at https://console.anthropic.com (requires a prepaid credit balance).
VITE_ANTHROPIC_API_KEY=

# Cloud sync (optional) — from a Firebase project's Web App config (console.firebase.google.com).
# Unlike the Anthropic key above, these are NOT secret: Firebase's client config is meant to be
# public in the bundle. Access control comes from Firestore Security Rules, not from hiding this.
# Safe to set directly as normal Vercel project environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
