rules_version = '2';

// Paste this into the Firebase console: Firestore Database → Rules.
// Not deployed via CLI — kept here purely as a reference copy.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // lineState/{uid} (which LINE reminders were already sent) is written only by the
    // server through the Admin SDK, which bypasses these rules. No client rule on purpose:
    // anything not matched above is denied.
  }
}
